# Skopiujcie do .env:  cp .env.example .env
# Plik .env jest w .gitignore – każdy może mieć własne porty/hasła.

# --- Limity zasobów (identyczne dla każdej bazy) -----------------------
# 16 GB RAM na komputerze -> 6 GB dla bazy, reszta dla systemu i aplikacji testowej.
# Zmieniając DB_MEMORY, przeskalujcie też cache w plikach konfiguracyjnych
# (shared_buffers, innodb_buffer_pool_size, cacheSizeGB, pagecache) – ok. 50% limitu.
DB_CPUS=4
DB_MEMORY=6g

# --- Dane logowania (wspólne dla wszystkich baz) ------------------------
DB_NAME=ecommerce
DB_USER=bench
DB_PASSWORD=bench_pass
DB_ROOT_PASSWORD=root_pass

# --- Wersje obrazów (przypięte – wpiszcie dokładne wersje do sprawozdania)
POSTGRES_VERSION=18
MARIADB_VERSION=12.3
MONGODB_VERSION=8.0
NEO4J_VERSION=2026.10

# --- Etykieta komputera w results/*.csv (zamiast nazwy urządzenia)
# Każda osoba w zespole wpisuje własną, np. pc1, pc2.
MACHINE=pc1

# --- Porty na hoście --------------------------------------------------
POSTGRES_PORT=5432
MARIADB_PORT=3306
MONGODB_PORT=27017
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
